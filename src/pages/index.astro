---
import CSCJ from '../layouts/CSCJ.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LeadForm from '../components/LeadForm.astro';
import Img from '../components/ui/Img.astro';

const path = '/';
---

<CSCJ
  title="Casa Sagrado Coração de Jesus — Retiros, Eventos e Celebrações"
  description="Espaço completo para retiros, formações, casamentos intimistas e eventos corporativos. Natureza, acolhimento e gastronomia artesanal."
  ogTitle="Casa Sagrado Coração de Jesus"
  ogImage="/images/entrada.png"
  canonical="https://cscjeventos.com.br/"
  currentPath={path}
>
  <div class="flex min-h-screen flex-col">
    <Header currentPath={path} />
    <main class="flex-1">

      <!-- 1. Hero -->
      <section class="relative overflow-hidden bg-primary text-primary-foreground">
        <div class="container-prose grid gap-10 py-16 md:grid-cols-12 md:gap-12 md:py-24">
          <div class="md:col-span-6 lg:col-span-5 flex flex-col justify-center">
            <h1 class="font-serif text-5xl leading-[1.05] text-balance md:text-6xl lg:text-7xl">
              Um espaço de <em class="not-italic" style="color: var(--gold)">paz</em> para encontros que transformam.
            </h1>
            <p class="mt-6 max-w-md text-base text-primary-foreground/85">
              Retiros, formações, casamentos intimistas, eventos corporativos e celebrações com propósito — em meio à natureza, com acolhimento e gastronomia artesanal.
            </p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a href="/contato" class="rounded-full px-6 py-3 text-sm font-semibold hover:brightness-95" style="background-color: var(--gold); color: var(--primary)">Solicitar orçamento</a>
              <button type="button" onclick="event.stopPropagation(); window.openWaPopup?.('hero')" class="rounded-full border border-primary-foreground/30 px-6 py-3 text-sm font-semibold text-primary-foreground hover:bg-primary-foreground/10">Falar no WhatsApp</button>
            </div>
            <dl class="mt-10 grid grid-cols-3 gap-6 border-t border-primary-foreground/20 pt-6 text-primary-foreground/85">
              <div><dt class="text-xs uppercase tracking-wider opacity-70">Tradição</dt><dd class="font-serif text-2xl">Décadas</dd></div>
              <div><dt class="text-xs uppercase tracking-wider opacity-70">Capacidade</dt><dd class="font-serif text-2xl">Grupos</dd></div>
              <div><dt class="text-xs uppercase tracking-wider opacity-70">Natureza</dt><dd class="font-serif text-2xl">Imersa</dd></div>
            </dl>
          </div>
          <div class="md:col-span-6 lg:col-span-7 relative">
            <div class="relative aspect-[4/5] overflow-hidden rounded-md shadow-2xl shadow-black/30">
              <Img src="entrada.png" alt="Ambiente interno da Casa Sagrado Coração de Jesus" class="h-full w-full object-cover" priority={true} width={800} height={1000} />
            </div>
            <div class="absolute -bottom-6 -left-6 hidden w-48 overflow-hidden rounded-md border-4 border-primary shadow-xl md:block">
              <Img src="capela.jpg" alt="Capela" class="h-44 w-full object-cover" width={192} height={176} />
            </div>
          </div>
        </div>
      </section>

      <!-- 2. Sobre a Casa -->
      <section class="bg-background">
        <div class="container-prose grid gap-12 py-20 md:grid-cols-12">
          <div class="md:col-span-4">
            <span class="eyebrow">Sobre a Casa</span>
            <h2 class="mt-3 font-serif text-4xl text-primary text-balance">Tradição espiritual e profissionalismo em um só lugar.</h2>
          </div>
          <div class="md:col-span-7 md:col-start-6">
            <p class="font-serif text-xl leading-relaxed text-foreground">Há décadas, a Casa acolhe grupos em busca de espiritualidade, propósito e convivência.</p>
            <p class="mt-4 text-foreground/80">Em seu novo momento de reestruturação e expansão, a Casa amplia sua atuação para receber também casamentos intimistas, bodas, imersões terapêuticas e eventos corporativos, mantendo sempre seu carisma de simplicidade, cuidado e acolhimento.</p>
            <p class="mt-4 text-foreground/80">Tradição e profissionalismo se unem para criar experiências profundas e memoráveis.</p>
            <a href="/sobre" class="mt-6 inline-block text-sm font-semibold text-accent hover:underline">Conhecer a história →</a>
          </div>
        </div>
      </section>

      <!-- 3. Diferenciais -->
      <section style="background-color: var(--cream)">
        <div class="container-prose py-20">
          <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
            <div>
              <span class="eyebrow">Diferenciais</span>
              <h2 class="mt-2 font-serif text-4xl text-primary">Um espaço versátil, preparado para cada grupo.</h2>
            </div>
            <a href="/espacos" class="text-sm font-semibold text-accent hover:underline">Ver todos os espaços →</a>
          </div>
          <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            <!-- Card: Natureza -->
            <article class="group rounded-md border border-border bg-card p-6 transition hover:border-accent hover:shadow-lg">
              <div class="grid h-11 w-11 place-items-center rounded-full bg-primary/10 text-primary group-hover:bg-primary group-hover:text-primary-foreground">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>
              </div>
              <h3 class="mt-5 font-serif text-xl text-primary">Natureza, jardins e trilhas</h3>
              <p class="mt-2 text-sm text-foreground/75">Área verde preservada, ideal para dinâmicas, caminhadas, cerimônias ao ar livre e contemplação.</p>
            </article>
            <!-- Card: Casamentos -->
            <article class="group rounded-md border border-border bg-card p-6 transition hover:border-accent hover:shadow-lg">
              <div class="grid h-11 w-11 place-items-center rounded-full bg-primary/10 text-primary group-hover:bg-primary group-hover:text-primary-foreground">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5"/></svg>
              </div>
              <h3 class="mt-5 font-serif text-xl text-primary">Casamentos &amp; celebrações</h3>
              <p class="mt-2 text-sm text-foreground/75">Ambientes internos e externos perfeitos para cerimônias intimistas, bodas e renovação de votos.</p>
            </article>
            <!-- Card: Auditórios -->
            <article class="group rounded-md border border-border bg-card p-6 transition hover:border-accent hover:shadow-lg">
              <div class="grid h-11 w-11 place-items-center rounded-full bg-primary/10 text-primary group-hover:bg-primary group-hover:text-primary-foreground">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/><rect width="20" height="14" x="2" y="6" rx="2"/></svg>
              </div>
              <h3 class="mt-5 font-serif text-xl text-primary">Auditórios e salas</h3>
              <p class="mt-2 text-sm text-foreground/75">Estrutura completa para palestras, workshops, treinamentos e reuniões estratégicas.</p>
            </article>
            <!-- Card: Acomodações -->
            <article class="group rounded-md border border-border bg-card p-6 transition hover:border-accent hover:shadow-lg">
              <div class="grid h-11 w-11 place-items-center rounded-full bg-primary/10 text-primary group-hover:bg-primary group-hover:text-primary-foreground">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 20v-8a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v8"/><path d="M4 10V6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v4"/><path d="M12 4v6"/><path d="M2 18h20"/></svg>
              </div>
              <h3 class="mt-5 font-serif text-xl text-primary">Acomodações para grupos</h3>
              <p class="mt-2 text-sm text-foreground/75">Hospedagem prática e acolhedora para retiros, formações e celebrações com pernoite.</p>
            </article>
            <!-- Card: Capela -->
            <article class="group rounded-md border border-border bg-card p-6 transition hover:border-accent hover:shadow-lg">
              <div class="grid h-11 w-11 place-items-center rounded-full bg-primary/10 text-primary group-hover:bg-primary group-hover:text-primary-foreground">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 9h4"/><path d="M12 7v5"/><path d="M14 21v-3a2 2 0 0 0-4 0v3"/><path d="m18 9 3.52 2.147a1 1 0 0 1 .48.854V19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-6.999a1 1 0 0 1 .48-.854L6 9"/><path d="M6 21V7a1 1 0 0 1 .376-.782l5-3.999a1 1 0 0 1 1.249.001l5 4A1 1 0 0 1 18 7v14"/></svg>
              </div>
              <h3 class="mt-5 font-serif text-xl text-primary">Capela e espiritualidade</h3>
              <p class="mt-2 text-sm text-foreground/75">Ambientes sagrados e silenciosos, opcionais conforme a proposta de cada grupo.</p>
            </article>
            <!-- Card: Gastronomia -->
            <article class="group rounded-md border border-border bg-card p-6 transition hover:border-accent hover:shadow-lg">
              <div class="grid h-11 w-11 place-items-center rounded-full bg-primary/10 text-primary group-hover:bg-primary group-hover:text-primary-foreground">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m16 2-2.3 2.3a3 3 0 0 0 0 4.2l1.8 1.8a3 3 0 0 0 4.2 0L22 8"/><path d="M15 15 3.3 3.3a4.2 4.2 0 0 0 0 6l7.3 7.3c.7.7 2 .7 2.8 0L15 15Zm0 0 7 7"/><path d="m2.1 21.8 6.4-6.3"/><path d="m19 5-7 7"/></svg>
              </div>
              <h3 class="mt-5 font-serif text-xl text-primary">Gastronomia artesanal</h3>
              <p class="mt-2 text-sm text-foreground/75">Cozinha afetiva com ingredientes frescos, sazonais e orgânicos cultivados na própria horta.</p>
            </article>
          </div>
        </div>
      </section>

      <!-- 4. Para quem -->
      <section class="bg-background">
        <div class="container-prose grid gap-6 py-20 md:grid-cols-12">
          <div class="md:col-span-7">
            <Img src="auditorio.jpg" alt="Área externa" class="aspect-[4/3] w-full rounded-md object-cover" width={800} height={600} />
          </div>
          <div class="md:col-span-5 flex flex-col justify-center">
            <span class="eyebrow">Para quem</span>
            <h2 class="mt-2 font-serif text-3xl text-primary">Religioso, corporativo, social e educacional.</h2>
            <ul class="mt-6 space-y-3 text-foreground/85">
              <li><strong class="text-primary">Religioso:</strong> paróquias, pastorais, retiros de jovens, casais e famílias.</li>
              <li><strong class="text-primary">Corporativo:</strong> workshops, treinamentos, convenções com hospedagem.</li>
              <li><strong class="text-primary">Desenvolvimento humano:</strong> imersões terapêuticas, coaching, yoga, meditação.</li>
              <li><strong class="text-primary">Educacional:</strong> formações escolares e retiros pedagógicos.</li>
              <li><strong class="text-primary">Celebrações:</strong> casamentos intimistas, bodas e renovação de votos.</li>
            </ul>
          </div>
          <div class="md:col-span-4">
            <Img src="capela-interna.jpg" alt="Capela interna" class="aspect-square w-full rounded-md object-cover" width={400} height={400} />
          </div>
          <div class="md:col-span-4">
            <Img src="auditorio-espacos.png" alt="Auditório" class="aspect-square w-full rounded-md object-cover" width={400} height={400} />
          </div>
          <div class="md:col-span-4">
            <Img src="quarto.jpg" alt="Quarto" class="aspect-square w-full rounded-md object-cover" width={400} height={400} />
          </div>
        </div>
      </section>

      <!-- 5. Gastronomia -->
      <section class="bg-primary text-primary-foreground">
        <div class="container-prose grid items-center gap-12 py-20 md:grid-cols-2">
          <div>
            <span class="eyebrow" style="color: var(--gold)">Gastronomia</span>
            <h2 class="mt-3 font-serif text-4xl">Sabores simples, afetivos e bem preparados.</h2>
            <p class="mt-5 text-primary-foreground/85">Mais do que refeições, cuidado traduzido em sabores. Nossa cozinha valoriza ingredientes frescos, sazonais e, sempre que possível, orgânicos cultivados na própria horta da Casa.</p>
            <p class="mt-4 text-primary-foreground/85">Cada prato é pensado para nutrir, acolher e sustentar jornadas longas — uma pausa de conforto que permanece na memória de quem passa por aqui.</p>
            <a href="/gastronomia" class="mt-7 inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-semibold hover:brightness-95" style="background-color: var(--gold); color: var(--primary)">Saber mais</a>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <Img src="cozinha.png" alt="Cozinha" class="aspect-[3/4] w-full rounded-md object-cover" width={400} height={533} />
            <Img src="restaurante.png" alt="Restaurante" class="mt-10 aspect-[3/4] w-full rounded-md object-cover" width={400} height={533} />
          </div>
        </div>
      </section>

      <!-- 6. Como reservar -->
      <section class="bg-background">
        <div class="container-prose py-20">
          <div class="mx-auto max-w-2xl text-center">
            <span class="eyebrow">Como reservar</span>
            <h2 class="mt-2 font-serif text-4xl text-primary">Quatro passos simples até o seu evento.</h2>
          </div>
          <ol class="mt-12 grid gap-6 md:grid-cols-4">
            <li class="rounded-md border border-border bg-card p-6">
              <div class="font-serif text-3xl" style="color: var(--gold)">01</div>
              <h3 class="mt-2 font-serif text-lg text-primary">Disponibilidade</h3>
              <p class="mt-1 text-sm text-foreground/75">Envie data e tipo de evento.</p>
            </li>
            <li class="rounded-md border border-border bg-card p-6">
              <div class="font-serif text-3xl" style="color: var(--gold)">02</div>
              <h3 class="mt-2 font-serif text-lg text-primary">Orçamento</h3>
              <p class="mt-1 text-sm text-foreground/75">Apresentamos formatos, valores e pacotes.</p>
            </li>
            <li class="rounded-md border border-border bg-card p-6">
              <div class="font-serif text-3xl" style="color: var(--gold)">03</div>
              <h3 class="mt-2 font-serif text-lg text-primary">Visita técnica</h3>
              <p class="mt-1 text-sm text-foreground/75">Opcional — conheça a estrutura pessoalmente.</p>
            </li>
            <li class="rounded-md border border-border bg-card p-6">
              <div class="font-serif text-3xl" style="color: var(--gold)">04</div>
              <h3 class="mt-2 font-serif text-lg text-primary">Confirmação</h3>
              <p class="mt-1 text-sm text-foreground/75">Reserve sua data e prepare-se para receber.</p>
            </li>
          </ol>
        </div>
      </section>

      <!-- 7. Fale com a equipe -->
      <section id="contato" style="background-color: var(--cream)">
        <div class="container-prose grid gap-12 py-20 md:grid-cols-12">
          <div class="md:col-span-5">
            <span class="eyebrow">Fale com a equipe</span>
            <h2 class="mt-2 font-serif text-4xl text-primary text-balance">Vamos planejar juntos seu próximo encontro.</h2>
            <p class="mt-5 text-foreground/80">Conte-nos sobre seu evento — retorno em até 1 dia útil pela nossa equipe comercial.</p>
            <div class="mt-8 flex items-center gap-3">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent" aria-hidden="true"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/></svg>
              <span class="text-sm text-foreground/80">Estacionamento amplo para carros e ônibus.</span>
            </div>
            <Img src="hall.jpg" alt="Acesso e estacionamento" class="mt-6 aspect-[4/3] w-full rounded-md object-cover" width={600} height={450} />
          </div>
          <div class="md:col-span-7">
            <div class="rounded-lg border border-border bg-card p-6 shadow-sm md:p-8">
              <LeadForm formId="cscj-home" formName="cscj-home" fonte="Site CSCJ — Home" />
            </div>
          </div>
        </div>
      </section>

    </main>
    <Footer currentPath={path} />
  </div>
</CSCJ>
