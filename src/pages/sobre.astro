---
import CSCJ from '../layouts/CSCJ.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const path = '/sobre';
---

<CSCJ
  title="A Casa — Casa Sagrado Coração de Jesus"
  description="Conheça a história, a vocação e o novo momento da Casa Sagrado Coração de Jesus."
  ogDescription="Tradição, espiritualidade e profissionalismo, lado a lado."
  ogImage="/images/entrada.png"
  canonical="https://cscjeventos.com.br/sobre"
  currentPath={path}
>
  <div class="flex min-h-screen flex-col">
    <Header currentPath={path} />
    <main class="flex-1">
      <article class="container-prose grid gap-12 py-20 md:grid-cols-12">
        <header class="md:col-span-12">
          <span class="eyebrow">A Casa</span>
          <h1 class="mt-3 font-serif text-5xl text-primary text-balance md:text-6xl">Décadas acolhendo grupos em busca de propósito.</h1>
        </header>
        <div class="md:col-span-7 space-y-5 text-foreground/85 text-lg leading-relaxed">
          <p class="font-serif text-2xl text-primary">A Casa Sagrado Coração de Jesus é um espaço completo para retiros, formações, encontros de desenvolvimento humano, eventos corporativos e celebrações intimistas.</p>
          <p>Em meio à natureza, oferecemos ambientes acolhedores, estrutura versátil e uma atmosfera de paz que favorece integração, reflexão, celebração e resultados.</p>
          <p>A Casa está sendo reposicionada e profissionalizada com o apoio da BSG Participações, referência nacional em gestão de hotelaria e eventos. Processos comerciais estruturados, marketing estratégico e atendimento profissional — sem perder a essência espiritual, a simplicidade e a vocação acolhedora.</p>
        </div>
        <aside class="md:col-span-4 md:col-start-9">
          <div class="rounded-md border border-border bg-card p-6">
            <h3 class="font-serif text-xl text-primary">Um novo momento, a mesma essência</h3>
            <ul class="mt-4 space-y-3 text-sm text-foreground/80">
              <li>• Apoio da BSG Participações</li>
              <li>• Profissionalização de processos</li>
              <li>• Atendimento estruturado</li>
              <li>• Carisma de simplicidade e acolhimento</li>
            </ul>
            <a href="/contato" class="mt-6 inline-flex w-full justify-center rounded-full bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground hover:bg-secondary">Conversar com a equipe</a>
          </div>
        </aside>
      </article>
    </main>
    <Footer currentPath={path} />
  </div>
</CSCJ>
