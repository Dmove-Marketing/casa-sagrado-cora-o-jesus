---
import Base from '../layouts/Base.astro';
import config from '../../config.json';
import { tipoEventoReligiososOptions } from '../scripts/lead-payload';

const submitUrl = config.forms['lead-form']?.webhooks[0] ?? '';
const project   = config.project_slug;
const P = 'https://media.dmove.com.br/clients/sagrado-coracao/photos';

const links = [
  {
    href:     'https://cscjeventos.com.br/',
    label:    'Site oficial',
    sublabel: 'cscjeventos.com.br',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>`,
  },
  {
    href:     'https://cscjeventos.com.br/eventos-religiosos',
    label:    'Eventos Religiosos',
    sublabel: 'Retiros, encontros e formações',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2v20M2 8h20"/></svg>`,
  },
];
---

<Base
  title="Casa Sagrado Coração de Jesus | Bio"
  description="Natureza, acolhimento e estrutura para eventos religiosos e corporativos."
  ogImage={`${P}/hero-vista-aerea-casa.webp`}
  canonical="https://cscjeventos.com.br/bio"
  whatsAppTipoEventoOptions={tipoEventoReligiososOptions}
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;1,500&family=Nunito+Sans:wght@400;600;700&display=swap" />
  </Fragment>

  <main class="bio">
    <div class="bio-fundo" aria-hidden="true">
      <picture>
        <source media="(min-width: 768px)" srcset={`${P}/hero-vista-aerea-casa.webp`} />
        <img src={`${P}/hero-vista-aerea-casa.webp`} alt="" width="1824" height="1223" fetchpriority="high" />
      </picture>
    </div>

    <div class="bio-selo">
      <img src={`${P}/logo-casa-sagrado-coracao.webp`} alt="Casa Sagrado Coração de Jesus" width="840" height="324" />
    </div>

    <div class="bio-conteudo">

      <p class="bio-tagline">Natureza, acolhimento e estrutura para eventos religiosos e corporativos</p>

      <nav class="bio-links" aria-label="Links da Casa Sagrado Coração">
        {links.map((l) => (
          <a class="bio-link" href={l.href}>
            <span class="bio-link-icone" set:html={l.icon} />
            <span class="bio-link-texto">
              <span class="bio-link-label">{l.label}</span>
              <span class="bio-link-sub">{l.sublabel}</span>
            </span>
          </a>
        ))}
      </nav>

      <div class="bio-form-wrap">
        <p class="bio-form-titulo">Solicite orçamento</p>
        <form
          class="bio-form"
          data-form-id="cscj-bio"
          data-submit-url={submitUrl}
          data-fonte="Landing page/bio"
          data-project={project}
          data-grid-id="bio-form-campos"
          data-success-id="bio-form-success"
          novalidate
        >
          <input name="website" type="text" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <div class="bio-campos" id="bio-form-campos">

            <div class="bio-campo bio-campo-full">
              <label for="form-field-nome">Nome</label>
              <input id="form-field-nome" name="nome" type="text" autocomplete="name" required />
            </div>

            <div class="bio-campo">
              <label for="form-field-telefone">Telefone</label>
              <input id="form-field-telefone" name="telefone" type="tel" inputmode="tel" autocomplete="tel" required />
            </div>

            <div class="bio-campo">
              <label for="form-field-email">E-mail</label>
              <input id="form-field-email" name="email" type="email" autocomplete="email" required />
            </div>

            <div class="bio-campo bio-campo-full">
              <label for="form-field-grupo">Igreja ou grupo</label>
              <input id="form-field-grupo" name="grupo" type="text" autocomplete="organization" required />
            </div>

            <div class="bio-campo">
              <label for="form-field-tipo_evento">Tipo de evento</label>
              <div class="bio-select-wrap">
                <select id="form-field-tipo_evento" name="tipo_evento" required>
                  <option value="" selected disabled>Selecione</option>
                  {tipoEventoReligiososOptions.map((o) => (
                    <option value={o.value}>{o.label}</option>
                  ))}
                </select>
                <svg class="bio-select-seta" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
              </div>
            </div>

            <div class="bio-campo">
              <label for="form-field-hospedagem">Hospedagem</label>
              <div class="bio-select-wrap">
                <select id="form-field-hospedagem" name="hospedagem" required>
                  <option value="" selected disabled>Selecione</option>
                  <option>Com hospedagem</option>
                  <option>Sem hospedagem</option>
                </select>
                <svg class="bio-select-seta" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
              </div>
            </div>

            <div class="bio-campo">
              <label for="form-field-data_evento">Data do evento</label>
              <input id="form-field-data_evento" name="data_evento" type="text" placeholder="dd/mm/aaaa" data-form-datepicker required />
            </div>

            <div class="bio-campo">
              <label for="form-field-participantes">Nº de participantes</label>
              <input id="form-field-participantes" name="participantes" type="number" inputmode="numeric" min="1" required />
            </div>

            <div class="bio-campo bio-campo-full">
              <label for="form-field-detalhes_adicionais">Mensagem <span class="bio-opcional">(opcional)</span></label>
              <textarea id="form-field-detalhes_adicionais" name="detalhes_adicionais" rows="3" placeholder="Conte-nos um pouco sobre seu evento ou retiro..."></textarea>
            </div>

            <div class="bio-campo bio-campo-full bio-acao">
              <button class="bio-btn form-submit" type="button">
                <span class="btn-text">Solicitar orçamento</span>
                <span class="btn-loading" style="display:none">Enviando...</span>
              </button>
            </div>

          </div>
        </form>

        <div id="bio-form-success" class="bio-success">
          <div class="bio-success-icon">✓</div>
          <p class="bio-success-titulo">Orçamento enviado!</p>
          <p class="bio-success-sub">Nossa equipe entrará em contato em breve.</p>
        </div>

        <p class="bio-aviso">Suas informações são usadas somente para retorno de orçamento.</p>
      </div>

    </div>
  </main>

  <footer class="bio-rodape" style="position:relative;z-index:1">
    <div class="bio-rodape__conteudo">
      <img class="bio-rodape__logo" src={`${P}/logo-casa-sagrado-coracao-rodape.webp`} alt="Casa Sagrado Coração, Missionárias do SCJ Cabrini" width="640" height="247" loading="lazy" />
      <p class="bio-rodape__direitos">© <span data-bio-ano></span> Casa Sagrado Coração · Missionárias do SCJ Cabrini. Todos os direitos reservados.</p>
      <p class="bio-rodape__credito">Desenvolvido por <a class="bio-rodape__dmove" href="https://dmove.com.br" target="_blank" rel="noopener"><img src={`${P}/logo-dmove.webp`} alt="Dmove" width="600" height="134" loading="lazy" /></a></p>
    </div>
  </footer>

</Base>

<style is:global>
/* =========================================================
   Bio — Casa Sagrado Coração
   Estrutura padrão Dmove bio (ref: Farofa)
   ========================================================= */
:root {
  --bio-destaque:    #c99a45;
  --bio-destaque2:   #e3bd76;
  --bio-marinho:     #0d254d;
  --bio-marinho-esc: #07192f;
  --bio-creme:       #f8f3eb;
  --bio-creme-esc:   #efe5d4;
  --bio-fonte-titulo: "Playfair Display", Georgia, serif;
  --bio-fonte-texto:  "Nunito Sans", system-ui, sans-serif;
  --bio-raio:        8px;
}
*, *::before, *::after { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0; padding: 0;
  background: var(--bio-marinho-esc);
  color: var(--bio-creme);
  font-family: var(--bio-fonte-texto);
  font-weight: 500;
  -webkit-font-smoothing: antialiased;
  min-height: 100svh;
}
img { max-width: 100%; height: auto; display: block; }
a { color: inherit; text-decoration: none; }

/* ── Layout ─────────────────────────────────────────────── */
.bio {
  position: relative; isolation: isolate;
  min-height: 100svh;
  display: flex; flex-direction: column; align-items: center;
  padding: 0 clamp(20px, 5vw, 40px) clamp(40px, 5vw, 56px);
}

/* ── Fundo fixo ─────────────────────────────────────────── */
.bio-fundo { position: fixed; inset: 0; z-index: -2; overflow: hidden; }
.bio-fundo img {
  width: 100%; height: 100%; object-fit: cover; object-position: 50% 40%;
  filter: brightness(.45) saturate(.7);
}
.bio::before {
  content: ""; position: fixed; inset: 0; z-index: -1;
  background:
    radial-gradient(ellipse at 50% 0%, rgba(13,37,77,.4) 0%, transparent 65%),
    linear-gradient(180deg, rgba(7,25,47,.55) 0%, rgba(7,25,47,.2) 40%, rgba(7,25,47,.7) 100%);
}

/* ── Conteúdo ───────────────────────────────────────────── */
.bio-conteudo {
  width: 100%; max-width: 440px;
  display: flex; flex-direction: column; align-items: center; gap: clamp(24px, 3.5vw, 36px);
  padding-top: clamp(24px, 3.5vw, 36px);
}

/* ── Selo / logo ────────────────────────────────────────── */
.bio-selo {
  position: relative; z-index: 3; align-self: center;
  display: block;
  background: linear-gradient(180deg, #fffaf1 0%, var(--bio-creme-esc) 100%);
  border-radius: 0 0 34px 34px;
  padding: clamp(16px, 2vw, 22px) clamp(32px, 3.6vw, 50px) clamp(18px, 2.2vw, 26px);
  box-shadow: 0 6px 0 -1px var(--bio-destaque), 0 18px 40px rgba(7,25,47,.25);
  animation: bio-desce 1.1s cubic-bezier(.22,.61,.36,1) .1s both;
}
.bio-selo img { width: clamp(180px, 16vw, 230px); height: auto; display: block; }
@keyframes bio-desce { from { transform: translateY(-110%); } to { transform: none; } }
.bio-tagline {
  margin: 0;
  font-size: clamp(13px, 1.2vw, 15px);
  font-style: italic;
  line-height: 1.5;
  color: rgba(248,243,235,.72);
  max-width: 28ch;
}

/* ── Links ──────────────────────────────────────────────── */
.bio-links { width: 100%; display: flex; flex-direction: column; gap: 10px; }
.bio-link {
  display: flex; align-items: center; gap: 14px;
  padding: 14px 18px;
  border-radius: var(--bio-raio);
  border: 1.5px solid rgba(248,243,235,.18);
  background: rgba(7,25,47,.45);
  backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
  transition: background .2s, border-color .2s, transform .15s;
}
.bio-link:hover {
  background: rgba(7,25,47,.65);
  border-color: rgba(201,154,69,.5);
  transform: translateY(-2px);
}
.bio-link:active { transform: translateY(0); }
.bio-link-icone {
  flex: none; width: 20px; height: 20px;
  display: flex; align-items: center; justify-content: center;
  color: var(--bio-destaque2); opacity: .85;
}
.bio-link-icone svg { width: 20px; height: 20px; display: block; }
.bio-link-texto { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
.bio-link-label { font-weight: 700; font-size: 14px; line-height: 1.2; }
.bio-link-sub   { font-size: 11px; opacity: .55; line-height: 1.2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* ── Formulário ─────────────────────────────────────────── */
.bio-form-wrap {
  width: 100%;
  border-radius: 12px;
  border: 1.5px solid rgba(248,243,235,.15);
  background: rgba(7,25,47,.48);
  backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
  padding: clamp(20px, 3vw, 28px);
}
.bio-form-titulo {
  font-family: var(--bio-fonte-titulo);
  font-size: clamp(22px, 2.2vw, 28px);
  font-style: italic; font-weight: 500;
  line-height: 1; letter-spacing: .01em;
  color: var(--bio-creme);
  margin: 0 0 18px;
}
.bio-campos {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px 12px;
  align-items: end;
}
.bio-campo { display: flex; flex-direction: column; gap: 5px; min-width: 0; }
.bio-campo-full { grid-column: 1 / -1; }
.bio-campo label {
  font-size: 11px; font-weight: 700;
  text-transform: uppercase; letter-spacing: .06em; line-height: 1;
  color: rgba(248,243,235,.6);
}

.bio-campo input,
.bio-campo select,
.bio-campo textarea {
  width: 100%; min-width: 0;
  font-family: var(--bio-fonte-texto); font-size: 15px; font-weight: 600;
  color: var(--bio-creme);
  background: rgba(255,255,255,.07);
  border: 1.5px solid rgba(248,243,235,.18);
  border-radius: var(--bio-raio);
  padding: 10px 12px;
  transition: border-color .2s, box-shadow .2s;
  -webkit-appearance: none; appearance: none;
}
.bio-campo input::placeholder { color: rgba(248,243,235,.3); font-weight: 500; }
.bio-campo input:focus,
.bio-campo select:focus,
.bio-campo textarea:focus {
  outline: none;
  border-color: var(--bio-destaque);
  box-shadow: 0 0 0 3px rgba(201,154,69,.2);
}
.bio-campo select { cursor: pointer; padding-right: 32px; }
.bio-campo textarea { resize: none; }
.bio-opcional { font-weight: 400; opacity: .55; font-size: .85em; }
.bio-campo select option { background: #07192f; color: var(--bio-creme); }

.bio-select-wrap { position: relative; }
.bio-select-seta {
  position: absolute; right: 9px; top: 50%; transform: translateY(-50%);
  width: 16px; height: 16px; pointer-events: none;
  color: rgba(248,243,235,.45);
}

.bio-acao { margin-top: 4px; }
.bio-btn {
  width: 100%;
  display: flex; align-items: center; justify-content: center;
  padding: 13px 20px;
  border: 0; border-radius: var(--bio-raio);
  font-family: var(--bio-fonte-texto); font-weight: 700; font-size: 15px;
  background: var(--bio-destaque); color: var(--bio-marinho-esc);
  cursor: pointer;
  transition: background .2s;
}
.bio-btn:hover { background: var(--bio-destaque2); }
.bio-btn:disabled { opacity: .6; cursor: not-allowed; }

/* Sucesso */
.bio-success { display: none; text-align: center; padding: 16px 0 8px; }
.bio-success.active { display: block; }
.bio-success-icon {
  width: 46px; height: 46px; border-radius: 50%;
  background: var(--bio-destaque); color: var(--bio-marinho-esc);
  display: grid; place-items: center; margin: 0 auto 12px;
  font-size: 18px; font-weight: 700;
}
.bio-success-titulo {
  font-family: var(--bio-fonte-titulo); font-style: italic;
  font-size: 24px; margin: 0 0 6px; color: var(--bio-creme);
}
.bio-success-sub { font-size: 14px; opacity: .7; margin: 0; }

.bio-aviso { margin: 12px 0 0; font-size: 11px; line-height: 1.4; color: rgba(248,243,235,.35); text-align: center; }

.field-error { color: #f87171; font-size: .75rem; margin-top: 3px; display: none; }
.field-error.visible { display: block; }

/* ── Rodapé ─────────────────────────────────────────────── */
.bio-rodape {
  background: var(--bio-marinho-esc);
  color: rgba(248,243,235,.6);
  padding: 44px 0 28px;
}
.bio-rodape__conteudo {
  max-width: 1100px; margin: 0 auto; padding: 0 24px;
  display: flex; flex-direction: column; align-items: center; gap: 14px; text-align: center;
}
.bio-rodape__logo { width: 220px; margin-bottom: 8px; }
.bio-rodape__direitos,
.bio-rodape__credito { margin: 0; font-size: .8rem; font-family: var(--bio-fonte-texto); }
.bio-rodape__credito { display: flex; align-items: center; gap: 10px; }
.bio-rodape__dmove { display: block; transition: opacity .25s; }
.bio-rodape__dmove:hover { opacity: .75; }
.bio-rodape__dmove img { width: 64px; height: auto; }
@media (max-width: 480px) { .bio-rodape__logo { width: 180px; } }

/* ── Flatpickr: adapta ao tema escuro ───────────────────── */
.flatpickr-calendar {
  font-family: var(--bio-fonte-texto) !important;
  background: #07192f !important;
  border-color: rgba(248,243,235,.2) !important;
  border-radius: var(--bio-raio) !important;
  color: var(--bio-creme) !important;
  box-shadow: 0 12px 32px -8px rgba(0,0,0,.7) !important;
}
.flatpickr-day { color: var(--bio-creme) !important; }
.flatpickr-day:hover { background: rgba(201,154,69,.25) !important; }
.flatpickr-day.selected,
.flatpickr-day.selected:hover { background: var(--bio-destaque) !important; border-color: var(--bio-destaque) !important; }
.flatpickr-months,
.flatpickr-weekdays { background: rgba(0,0,0,.3) !important; color: var(--bio-creme) !important; }
.flatpickr-weekday { color: rgba(248,243,235,.55) !important; }
.flatpickr-prev-month svg,
.flatpickr-next-month svg { fill: var(--bio-creme) !important; }

/* ── Responsivo ─────────────────────────────────────────── */
@media (max-width: 480px) {
  .bio-campos { grid-template-columns: 1fr; }
}
</style>

<script>
  import { initForms } from '../scripts/forms';
  import flatpickr from 'flatpickr';
  import { Portuguese } from 'flatpickr/dist/l10n/pt.js';
  import 'flatpickr/dist/flatpickr.min.css';

  function boot() {
    initForms();
    document.querySelectorAll<HTMLInputElement>('[data-form-datepicker]').forEach(el => {
      if (el.dataset.flatpickrReady) return;
      el.dataset.flatpickrReady = 'true';
      flatpickr(el, { locale: Portuguese, dateFormat: 'd/m/Y', minDate: 'today', allowInput: true });
    });
    const ano = document.querySelector('[data-bio-ano]');
    if (ano) ano.textContent = String(new Date().getFullYear());
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }
</script>
