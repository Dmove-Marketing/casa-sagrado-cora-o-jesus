---
import CSCJ from '../layouts/CSCJ.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LeadForm from '../components/LeadForm.astro';

const path = '/contato';
---

<CSCJ
  title="Contato e Orçamento — Casa Sagrado Coração de Jesus"
  description="Solicite orçamento, tire dúvidas e agende sua visita técnica. Resposta em até 1 dia útil."
  ogTitle="Contato — Casa Sagrado Coração de Jesus"
  ogDescription="Fale com nossa equipe comercial."
  ogImage="/images/entrada.png"
  canonical="https://cscjeventos.com.br/contato"
  currentPath={path}
>
  <div class="flex min-h-screen flex-col">
    <Header currentPath={path} />
    <main class="flex-1">
      <section class="container-prose grid gap-12 py-20 md:grid-cols-12">
        <div class="md:col-span-5">
          <span class="eyebrow">Contato</span>
          <h1 class="mt-3 font-serif text-5xl text-primary text-balance">Vamos planejar seu próximo encontro.</h1>
          <p class="mt-5 text-foreground/80">Preencha o formulário e nossa equipe comercial responderá em até 1 dia útil. Prefere falar agora? Use os canais ao lado.</p>
          <ul class="mt-8 space-y-4">
            <li class="flex items-start gap-3">
              <span class="grid h-10 w-10 place-items-center rounded-full bg-primary/10 text-primary">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.992 16.342a2 2 0 0 1 .094 1.167l-1.065 3.29a1 1 0 0 0 1.236 1.168l3.413-.998a2 2 0 0 1 1.099.092 10 10 0 1 0-4.777-4.719"/></svg>
              </span>
              <div>
                <div class="font-semibold text-foreground">WhatsApp</div>
                <button type="button" onclick="event.stopPropagation(); window.openWaPopup?.('contato')" class="text-sm text-accent hover:underline">Falar pelo WhatsApp</button>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="grid h-10 w-10 place-items-center rounded-full bg-primary/10 text-primary">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384"/></svg>
              </span>
              <div>
                <div class="font-semibold text-foreground">Equipe Comercial</div>
                <div class="text-sm text-foreground/75">Segunda a sexta</div>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="grid h-10 w-10 place-items-center rounded-full bg-primary/10 text-primary">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
              </span>
              <div>
                <div class="font-semibold text-foreground">Localização</div>
                <div class="text-sm text-foreground/75">Ambiente silencioso, rodeado de natureza, com fácil acesso.</div>
              </div>
            </li>
          </ul>
        </div>
        <div class="md:col-span-7">
          <div class="rounded-lg border border-border bg-card p-6 shadow-sm md:p-8">
            <h2 class="font-serif text-2xl text-primary">Solicitar orçamento</h2>
            <p class="mt-1 text-sm text-muted-foreground">Conte-nos sobre seu evento, retiro ou celebração.</p>
            <div class="mt-6">
              <LeadForm formId="cscj-contato" formName="cscj-contato" fonte="Site CSCJ — Contato" />
            </div>
          </div>
        </div>
      </section>
    </main>
    <Footer currentPath={path} />
  </div>
</CSCJ>
