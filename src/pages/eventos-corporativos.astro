---
import Base from '../layouts/Base.astro';
import config from '../../config.json';
import { tipoEventoCorporativosOptions } from '../scripts/lead-payload';

const submitUrl = config.forms['lead-form']?.webhooks[0] ?? '';
const project   = config.project_slug;
const P = 'https://media.dmove.com.br/clients/sagrado-coracao/photos';
const V = 'https://media.dmove.com.br/clients/sagrado-coracao/videos';
---

<Base
  title="Eventos corporativos em São Paulo | Casa Sagrado Coração"
  description="Workshops, treinamentos e convenções em São Paulo, com salas e auditório para até 130 convidados, 62 quartos, gastronomia própria e áreas verdes."
  ogTitle="Eventos corporativos em São Paulo | Casa Sagrado Coração"
  ogDescription="Um espaço para reunir equipes e fortalecer conexões. Estrutura, natureza, hospedagem e gastronomia em um só lugar."
  ogImage={`${P}/hero-vista-aerea-casa.webp`}
  canonical="https://cscjeventos.com.br/eventos-corporativos"
  whatsAppShowEmpresaField={true}
  whatsAppTipoEventoOptions={tipoEventoCorporativosOptions}
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;1,500;1,600&display=swap" rel="stylesheet" />
  </Fragment>

<!-- Ícones reutilizados -->
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <symbol id="cruz" viewBox="19 19.5 90.5 103"><path fill="currentColor" d="M16.0938 63.5938Q14.6094 60.4688 11.3281 57.3438Q14.5312 54.3750 16.0938 51.2500L22.5781 55.8594L22.5781 58.9844ZM73.8281 58.9062L73.8281 55.7812L80.2344 51.2500Q81.7969 54.3750 85.0000 57.3438Q81.7969 60.4688 80.2344 63.5938ZM54.3750 88.5938Q51.4062 90.1562 48.1250 93.3594Q45.1562 90.1562 42.1094 88.5938L46.7188 82.1094L49.8438 82.1094ZM49.7656 17.7344L46.6406 17.7344L42.1094 11.2500Q45.1562 9.6875 48.1250 6.4062Q51.3281 9.6875 54.3750 11.2500ZM53.9062 63.1250L69.5312 63.1250L83.7500 71.7188Q84.3750 64.5312 92.7344 57.2656Q84.3750 50.1562 83.7500 43.0469L69.5312 51.7188L53.9062 51.7188L53.9062 22.0312L62.5000 7.8125Q55.3125 7.0312 48.1250 -1.2500Q41.0156 7.0312 33.9062 7.8125L42.5000 22.0312L42.5000 51.7188L26.8750 51.7188L12.6562 43.0469Q11.9531 50.1562 3.5938 57.3438Q11.9531 64.5312 12.6562 71.7188L26.8750 63.1250L42.5000 63.1250L42.5000 77.7344L33.9062 92.0312Q41.0156 92.8125 48.1250 101.0938Q55.3125 92.8125 62.5000 92.0312L53.9062 77.7344ZM46.4062 69.8438L46.4062 58.9844L38.4375 58.9844L38.4375 55.8594L46.4062 55.8594L46.4062 29.6094L50.0781 29.6094L50.0781 55.8594L57.9688 55.8594L57.9688 58.9844L50.0781 58.9844L50.0781 69.8438Z" transform="translate(16.40625 121.09375) scale(1 -1)"/></symbol>
  <symbol id="icone-whatsapp" viewBox="0 0 32 32"><path fill="currentColor" d="M16.04 3C8.86 3 3.04 8.82 3.04 16c0 2.3.6 4.53 1.74 6.5L3 29l6.68-1.75A12.94 12.94 0 0 0 16.04 29C23.22 29 29 23.18 29 16S23.22 3 16.04 3zm0 23.63c-2 0-3.95-.54-5.66-1.55l-.4-.24-3.97 1.04 1.06-3.87-.26-.4A10.6 10.6 0 0 1 5.4 16c0-5.87 4.77-10.64 10.64-10.64S26.66 10.13 26.66 16 21.9 26.63 16.04 26.63zm5.83-7.96c-.32-.16-1.89-.93-2.18-1.04-.3-.1-.5-.16-.72.16-.21.32-.82 1.04-1 1.25-.19.21-.37.24-.69.08-.32-.16-1.35-.5-2.57-1.59-.95-.85-1.59-1.9-1.78-2.22-.18-.32-.02-.49.14-.65.14-.14.32-.37.48-.56.16-.19.21-.32.32-.53.1-.21.05-.4-.03-.56-.08-.16-.72-1.73-.98-2.37-.26-.62-.52-.54-.72-.55h-.61c-.21 0-.56.08-.85.4-.29.32-1.12 1.09-1.12 2.66s1.15 3.09 1.31 3.3c.16.21 2.26 3.45 5.47 4.84.76.33 1.36.53 1.83.68.77.24 1.47.21 2.02.13.62-.09 1.89-.77 2.16-1.52.27-.75.27-1.39.19-1.52-.08-.13-.29-.21-.61-.37z"/></symbol>
  <symbol id="icone-google" viewBox="0 0 24 24"><path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.4h6.5a5.6 5.6 0 0 1-2.4 3.6v3h3.9c2.2-2.1 3.5-5.1 3.5-8.7z"/><path fill="#34A853" d="M12 24c3.2 0 6-1.1 8-2.9l-3.9-3c-1.1.7-2.5 1.2-4.1 1.2-3.1 0-5.8-2.1-6.7-5H1.3v3.1A12 12 0 0 0 12 24z"/><path fill="#FBBC05" d="M5.3 14.3a7.2 7.2 0 0 1 0-4.6V6.6H1.3a12 12 0 0 0 0 10.8z"/><path fill="#EA4335" d="M12 4.8c1.8 0 3.3.6 4.6 1.8l3.4-3.4A12 12 0 0 0 1.3 6.6l4 3.1c.9-2.8 3.6-4.9 6.7-4.9z"/></symbol>
</svg>

<!-- 01 · HERO -->
<section class="er-hero er-hero--corporativos" id="topo">
  <div class="er-hero__foto er-foto er-foto--escura">
    <picture>
      <source media="(max-width: 959px)" srcset={`${P}/hero-vista-aerea-casa-mobile.webp`} width="556" height="1050" />
      <img src={`${P}/hero-vista-aerea-casa.webp`} alt="Vista aérea da Casa Sagrado Coração cercada de árvores, em São Paulo" width="1824" height="1223" loading="eager" fetchpriority="high" />
    </picture>
  </div>

  <a class="er-hero__selo" href="#topo" aria-label="Casa Sagrado Coração, início da página">
    <img src={`${P}/logo-casa-sagrado-coracao.webp`} alt="Casa Sagrado Coração, Missionárias do SCJ Cabrini" width="840" height="324" />
  </a>

  <div class="er-container er-hero__grade">
    <div class="er-hero__texto">
      <h1 class="er-titulo er-titulo--grande er-anima-entrada">Um espaço para <br class="er-br-desktop" /><span class="er-destaque">reunir equipes</span> e <br class="er-br-desktop" />fortalecer conexões</h1>
      <p class="er-hero__paragrafo er-anima-entrada">Workshops, treinamentos e convenções em <br class="er-br-desktop" />um ambiente que reúne estrutura, natureza, <br class="er-br-desktop" />hospedagem e gastronomia para sua equipe.</p>
      <a class="er-botao er-hero__cta er-anima-entrada" href="#contato">Solicite orçamento</a>
      <button class="er-hero__whats er-anima-entrada" type="button" onclick="event.stopPropagation(); window.openWaPopup?.('er-hero')">
        <svg aria-hidden="true"><use href="#icone-whatsapp"/></svg>
        <span>Prefere conversar? <br class="er-br-mobile" />Fale pelo WhatsApp</span>
      </button>
    </div>

    <form
      class="er-formulario er-anima-entrada"
      id="orcamento"
      data-form-id="cscj-corporativos-hero"
      data-submit-url={submitUrl}
      data-fonte="Landing page/eventos-corporativos"
      data-project={project}
      novalidate
    >
      <input type="text" name="website" style="display:none" aria-hidden="true" tabindex="-1" autocomplete="off" />
      <p class="er-formulario__titulo">Solicite um orçamento</p>
      <div class="er-campo er-campo--inteiro">
        <label for="h-nome">Nome</label>
        <input id="h-nome" name="nome" type="text" autocomplete="name" required />
      </div>
      <div class="er-campo">
        <label for="h-telefone">Telefone</label>
        <input id="h-telefone" name="telefone" type="tel" inputmode="tel" autocomplete="tel" required />
      </div>
      <div class="er-campo">
        <label for="h-email">E-mail</label>
        <input id="h-email" name="email" type="email" autocomplete="email" required />
      </div>
      <div class="er-campo">
        <label for="h-empresa">Empresa</label>
        <input id="h-empresa" name="empresa" type="text" autocomplete="organization" required />
      </div>
      <div class="er-campo">
        <label for="h-tipo">Tipo de evento</label>
        <select id="h-tipo" name="tipo_evento" required>
          <option value="" selected disabled>Selecione</option>
          {tipoEventoCorporativosOptions.map((o) => <option value={o.value}>{o.label}</option>)}
        </select>
      </div>
      <div class="er-campo">
        <label for="h-data">Data do evento</label>
        <input id="h-data" name="data_evento" type="text" inputmode="numeric" placeholder="dd/mm/aaaa" data-form-datepicker required />
      </div>
      <div class="er-campo">
        <label for="h-convidados">Nº de convidados</label>
        <input id="h-convidados" name="convidados" type="number" inputmode="numeric" min="1" required />
      </div>
      <div class="er-campo er-campo--inteiro">
        <label for="h-mensagem">Mensagem <span class="er-opcional">(opcional)</span></label>
        <textarea id="h-mensagem" name="detalhes_adicionais" rows="3" placeholder="Conte-nos um pouco sobre seu evento..."></textarea>
      </div>
      <button class="er-botao er-botao--escuro form-submit" type="button">
        <span class="btn-text">Solicitar orçamento</span>
        <span class="btn-loading" style="display:none">Enviando...</span>
      </button>
    </form>
  </div>
</section>

<!-- 02 · AUTORIDADE -->
<section class="er-autoridade" aria-label="Por que escolher a Casa">
  <div class="er-container">
    <ul class="er-atributos">
      <li class="er-atributo"><span class="er-atributo__destaque">Décadas</span><span class="er-atributo__rotulo">de tradição</span></li>
      <li class="er-atributo"><span class="er-atributo__destaque">62</span><span class="er-atributo__rotulo">quartos para hospedagem</span></li>
      <li class="er-atributo"><span class="er-atributo__destaque">Salas</span><span class="er-atributo__rotulo">e auditório</span></li>
      <li class="er-atributo"><span class="er-atributo__destaque">Natureza</span><span class="er-atributo__rotulo">integrada</span></li>
    </ul>
  </div>
</section>

<!-- 03 · EXPERIÊNCIA -->
<section class="er-experiencia" id="experiencia">
  <div class="er-container er-experiencia__grade">
    <div class="er-experiencia__texto">
      <span class="er-legenda er-revela"><svg class="er-cruz"><use href="#cruz"/></svg> Experiência 360°</span>
      <h2 class="er-titulo er-titulo--secao er-titulo--escuro er-revela">Mais possibilidades para os encontros <span class="er-destaque">da sua equipe.</span></h2>
      <p class="er-revela er-atraso-1">A Casa Sagrado Coração de Jesus, que faz parte <br class="er-br-desktop" />da Associação Madre Cabrini, oferece estrutura <br class="er-br-desktop" />para empresas que buscam novos ambientes <br class="er-br-desktop" />para reunir equipes, compartilhar conhecimentos <br class="er-br-desktop" />e desenvolver ideias. Com salas equipadas, <br class="er-br-desktop" />hospedagem, gastronomia própria e áreas verdes, <br class="er-br-desktop" />é possível concentrar diferentes momentos <br class="er-br-desktop" />da programação em um só lugar.</p>
    </div>
    <div class="er-experiencia__moldura er-revela er-atraso-1">
      <div class="er-video" data-video>
        <video src={`${V}/experiencia-casa.mp4`} poster={`${P}/video-capa-experiencia.webp`} muted loop playsinline preload="none" aria-label="Vídeo de apresentação da Casa Sagrado Coração"></video>
        <button class="er-video__som" type="button" aria-pressed="false" data-video-som>
          <svg class="er-desligado" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5L6 9H3v6h3l5 4z"/><path d="M22 9l-6 6M16 9l6 6"/></svg>
          <svg class="er-ligado" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5L6 9H3v6h3l5 4z"/><path d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13"/></svg>
          <span>Som</span>
        </button>
      </div>
    </div>
  </div>
</section>

<!-- 04 · GALERIA (logo depois da apresentação, como na LP religiosa) -->
<section class="er-galeria" id="galeria">
  <div class="er-container">
    <div class="er-galeria__cabecalho">
      <span class="er-legenda er-legenda--centro er-revela"><svg class="er-cruz"><use href="#cruz"/></svg> Galeria</span>
      <h2 class="er-titulo er-titulo--secao er-titulo--escuro er-revela">Conheça os ambientes <br class="er-br-mobile" /><span class="er-destaque">da nossa Casa</span></h2>
      <p class="er-galeria__dica er-revela er-atraso-1"><span class="er-so-desktop">Clique nas fotos para ampliar</span><span class="er-so-mobile">Deslize para ver mais <br />e toque para ampliar</span></p>
    </div>
    <div class="er-mosaico er-revela" data-mosaico>
      <button class="er-mosaico__item" type="button" style="grid-area:a;--i:0" aria-label="Ampliar foto: Palestra no auditório"><img src={`${P}/galeria-01-palestra-auditorio.webp`} alt="Grupo reunido no auditório durante palestra" width="1600" height="1066" loading="lazy" /></button>
      <button class="er-mosaico__item" type="button" style="grid-area:b;--i:1" aria-label="Ampliar foto: Salão de lanche"><img src={`${P}/galeria-04-sala-de-lanche.webp`} alt="Salão amplo com teto de madeira, janelas e mesas para lanche" width="1050" height="1400" loading="lazy" /></button>
      <button class="er-mosaico__item" type="button" style="grid-area:c;--i:2" aria-label="Ampliar foto: Jardim e quiosque"><img src={`${P}/galeria-03-jardim-quiosque.webp`} alt="Jardim arborizado com quiosque e gramado" width="1600" height="1066" loading="lazy" /></button>
      <button class="er-mosaico__item" type="button" style="grid-area:d;--i:3" aria-label="Ampliar foto: Pátio da fonte"><img src={`${P}/galeria-08-patio-fonte.webp`} alt="Pátio interno com fonte visto de cima" width="1600" height="1066" loading="lazy" /></button>
      <button class="er-mosaico__item" type="button" style="grid-area:e;--i:4" aria-label="Ampliar foto: Sala de convivência"><img src={`${P}/galeria-04-sala-de-convivencia.webp`} alt="Sala de convivência com sofás de couro, teto de madeira e janelas amplas" width="1086" height="1448" loading="lazy" /></button>
      <button class="er-mosaico__item" type="button" style="grid-area:f;--i:5" aria-label="Ampliar foto: Refeitório"><img src={`${P}/galeria-05-refeitorio-com-grupo.webp`} alt="Participantes de um encontro almoçando no refeitório" width="1600" height="1066" loading="lazy" /></button>
      <button class="er-mosaico__item" type="button" style="grid-area:g;--i:6" aria-label="Ampliar foto: Recepção"><img src={`${P}/galeria-06-recepcao.webp`} alt="Recepção com sofás, plantas e imagem de Santa Cabrini" width="1600" height="1066" loading="lazy" /></button>
      <button class="er-mosaico__item" type="button" style="grid-area:h;--i:7" aria-label="Ampliar foto: Sala de estar"><img src={`${P}/galeria-09-sala-de-estar.webp`} alt="Sala de estar ampla com sofás e janelas para o jardim" width="1600" height="1066" loading="lazy" /></button>
      <button class="er-mosaico__item" type="button" style="grid-area:i;--i:8" aria-label="Ampliar foto: Auditório"><img src={`${P}/galeria-07-auditorio-janelas.webp`} alt="Auditório com cadeiras estofadas e janelas em arco voltadas para as árvores" width="1536" height="1024" loading="lazy" /></button>
    </div>
  </div>

  <dialog class="er-lightbox" data-lightbox aria-label="Foto ampliada">
    <figure><img src="" alt="" /><figcaption><b data-lightbox-contador></b></figcaption></figure>
    <button class="er-lightbox__botao er-lightbox__fechar" type="button" data-lightbox-fechar aria-label="Fechar"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 3l12 12M15 3L3 15"/></svg></button>
    <button class="er-lightbox__botao er-lightbox__anterior" type="button" data-lightbox-anterior aria-label="Foto anterior"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M11 3L5 9l6 6"/></svg></button>
    <button class="er-lightbox__botao er-lightbox__proxima" type="button" data-lightbox-proxima aria-label="Próxima foto"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M7 3l6 6-6 6"/></svg></button>
  </dialog>
</section>

<!-- 05 · ESPAÇOS -->
<section class="er-espacos" id="espacos">
  <div class="er-container">
    <div class="er-espacos__cabecalho">
      <span class="er-legenda er-legenda--centro er-revela"><svg class="er-cruz"><use href="#cruz"/></svg> Espaços</span>
      <h2 class="er-titulo er-titulo--secao er-titulo--escuro er-revela">Ambientes que acompanham <br class="er-br-desktop" /><span class="er-destaque">os objetivos de cada encontro.</span></h2>
      <p class="er-galeria__dica er-espacos__dica">Deslize para conhecer cada ambiente</p>
    </div>
    <div class="er-percurso" data-percurso>
      <div class="er-percurso__visual" aria-hidden="true">
        <div class="er-percurso__moldura">
          <div class="er-percurso__janela">
            <img class="ativo" src="/images/espaco-salas-auditorio.webp" style="object-position:50% 60%" alt="Auditório com cadeiras universitárias em fileiras e janelas em arco" width="1532" height="1026" loading="lazy" />
            <img src={`${P}/espaco-salas-de-apoio.webp`} style="object-position:50% 50%" alt="Sala de apoio com cadeiras universitárias em fileiras e paredes de pedra ao fundo" width="1084" height="1355" loading="lazy" />
            <img src="/images/espaco-jardins.jpg" style="object-position:50% 50%" alt="Jardim com fonte, flores e árvores altas sob céu azul" width="1080" height="1350" loading="lazy" />
            <img src={`${P}/espaco-estacionamento.webp`} style="object-position:40% 50%" alt="Estacionamento amplo ao lado do prédio da Casa, cercado de árvores" width="1600" height="1066" loading="lazy" />
          </div>
          <div class="er-percurso__base"></div>
        </div>
        <div class="er-percurso__contador"><b data-percurso-num>I</b><span class="er-percurso__trilho"><span data-percurso-trilho></span></span><span>IV</span></div>
      </div>
      <ol class="er-percurso__lista">
        <li class="er-ambiente ativo" data-ambiente="0">
          <div class="er-ambiente__foto"><img src="/images/espaco-salas-auditorio.webp" style="object-position:50% 60%" alt="" width="1532" height="1026" loading="lazy" /></div>
          <span class="er-ambiente__numero">I</span>
          <h3>Salas e auditórios</h3>
          <span class="er-ambiente__fio" aria-hidden="true"></span>
          <p>Espaços equipados para treinamentos, workshops, palestras e reuniões de equipe, incluindo auditório <br class="er-br-desktop" />para até 130 convidados, com recursos audiovisuais <br class="er-br-desktop" />e iluminação natural.</p>
        </li>
        <li class="er-ambiente" data-ambiente="1">
          <div class="er-ambiente__foto"><img src={`${P}/espaco-salas-de-apoio.webp`} style="object-position:50% 50%" alt="" width="1084" height="1355" loading="lazy" /></div>
          <span class="er-ambiente__numero">II</span>
          <h3>Salas de apoio</h3>
          <span class="er-ambiente__fio" aria-hidden="true"></span>
          <p>Sete ambientes para atividades paralelas, dinâmicas em grupos menores e momentos de trabalho colaborativo.</p>
        </li>
        <li class="er-ambiente" data-ambiente="2">
          <div class="er-ambiente__foto"><img src="/images/espaco-jardins.jpg" style="object-position:50% 50%" alt="" width="1080" height="1350" loading="lazy" /></div>
          <span class="er-ambiente__numero">III</span>
          <h3>Jardins e áreas verdes</h3>
          <span class="er-ambiente__fio" aria-hidden="true"></span>
          <p>Ambientes cercados pela natureza, que ampliam as possibilidades de dinâmicas, caminhadas e pausas <br class="er-br-desktop" />ao ar livre.</p>
        </li>
        <li class="er-ambiente" data-ambiente="3">
          <div class="er-ambiente__foto"><img src={`${P}/espaco-estacionamento.webp`} style="object-position:40% 50%" alt="" width="1600" height="1066" loading="lazy" /></div>
          <span class="er-ambiente__numero">IV</span>
          <h3>Estacionamento amplo</h3>
          <span class="er-ambiente__fio" aria-hidden="true"></span>
          <p>Estrutura para até 30 carros, além de espaço para ônibus, facilitando a logística de chegada dos participantes.</p>
        </li>
      </ol>
      <div class="er-percurso__legenda" data-percurso-legenda aria-live="polite">
        <div class="er-percurso__nav">
          <button class="er-percurso__seta er-percurso__seta--anterior" type="button" data-percurso-anterior aria-label="Ambiente anterior" disabled><svg width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M11 3L5 9l6 6"/></svg></button>
          <span class="er-ambiente__numero" data-leg-num>I</span>
          <button class="er-percurso__seta er-percurso__seta--proxima" type="button" data-percurso-proxima aria-label="Próximo ambiente"><svg width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M7 3l6 6-6 6"/></svg></button>
        </div>
