      var limite = window.innerHeight * 0.92;
      alvos = alvos.filter(function (el) {
        if (el.classList.contains('visivel')) return false;
        var r = el.getBoundingClientRect();
        if (r.top < limite && r.bottom > 0) { revelar(el); return false; }
        return true;
      });
    }
    function agendar() { if (!agendado) { agendado = true; requestAnimationFrame(checar); } }
    window.addEventListener('scroll', agendar, { passive: true });
    window.addEventListener('resize', agendar);
    window.addEventListener('load', agendar);
    agendar();
  } else {
    alvos.forEach(revelar);
  }

  /* Autoridade: o 62 conta de 0 até o valor quando o selo aparece */
  var contador = document.querySelector('[data-contar]');
  if (contador && temIO && !reduzir && window.matchMedia('(min-width: 960px)').matches) {
    var alvoNum = +contador.getAttribute('data-contar');
    contador.textContent = '0';
    var ioContar = new IntersectionObserver(function (es) {
      if (!es[0].isIntersecting) return;
      ioContar.disconnect();
      var inicio = null;
      setTimeout(function () {
        requestAnimationFrame(function passo(t) {
          if (!inicio) inicio = t;
          var k = Math.min((t - inicio) / 1600, 1);
          contador.textContent = Math.round(alvoNum * (1 - Math.pow(1 - k, 3)));
          if (k < 1) requestAnimationFrame(passo);
        });
      }, 600);
    }, { threshold: 0.5 });
    ioContar.observe(contador);
  }

  /* Vídeo: carrega e toca só quando aparece na tela */
  var caixaVideo = document.querySelector('[data-video]');
  if (caixaVideo) {
    var video = caixaVideo.querySelector('video'), som = caixaVideo.querySelector('[data-video-som]');
    som.addEventListener('click', function () {
      video.muted = !video.muted;
      som.setAttribute('aria-pressed', String(!video.muted));
      if (video.paused) video.play().catch(function () {});
    });
    if (temIO && !reduzir) {
      new IntersectionObserver(function (es) {
        es.forEach(function (e) {
          if (e.isIntersecting) { video.preload = 'auto'; video.play().catch(function () {}); }
          else video.pause();
        });
      }, { threshold: 0.35 }).observe(caixaVideo);
    } else {
      video.controls = true;
    }
  }

  /* Espaços: janela fixa mostra a foto do ambiente que está no centro da tela */
  var percurso = document.querySelector('[data-percurso]');
  if (percurso && temIO) {
    var ambientes = percurso.querySelectorAll('.er-ambiente'), fotosPercurso = percurso.querySelectorAll('.er-percurso__janela img');
    var numPercurso = percurso.querySelector('[data-percurso-num]'), trilhoPercurso = percurso.querySelector('[data-percurso-trilho]');
    function mostrarAmbiente(i) {
      ambientes.forEach(function (a, k) { a.classList.toggle('ativo', k === i); });
      fotosPercurso.forEach(function (f, k) { f.classList.toggle('ativo', k === i); });
      if (fotosPercurso[i + 1]) fotosPercurso[i + 1].loading = 'eager';
      numPercurso.textContent = ['I', 'II', 'III', 'IV'][i];
      trilhoPercurso.style.transform = 'translateX(' + (i * 100) + '%)';
    }
    var ioAmb = new IntersectionObserver(function (es) {
      es.forEach(function (e) { if (e.isIntersecting) mostrarAmbiente(+e.target.getAttribute('data-ambiente')); });
    }, { rootMargin: '-45% 0px -45% 0px' });
    ambientes.forEach(function (a) { ioAmb.observe(a); });
  }

  /* Galeria: mosaico com lightbox */
  var mosaico = document.querySelector('[data-mosaico]'), lightbox = document.querySelector('[data-lightbox]');
  if (mosaico && lightbox && lightbox.showModal) {
    var itensMosaico = [].slice.call(mosaico.querySelectorAll('.er-mosaico__item')), fotoAtual = 0;
    var imgLb = lightbox.querySelector('img'), contLb = lightbox.querySelector('[data-lightbox-contador]');
    function abrirFoto(i) {
      fotoAtual = (i + itensMosaico.length) % itensMosaico.length;
      var img = itensMosaico[fotoAtual].querySelector('img');
      imgLb.src = img.currentSrc || img.src; imgLb.alt = img.alt;
      contLb.textContent = (fotoAtual + 1) + ' / ' + itensMosaico.length;
      if (!lightbox.open) lightbox.showModal();
    }
    itensMosaico.forEach(function (it, k) { it.addEventListener('click', function () { abrirFoto(k); }); });
    lightbox.querySelector('[data-lightbox-fechar]').addEventListener('click', function () { lightbox.close(); });
    lightbox.querySelector('[data-lightbox-anterior]').addEventListener('click', function () { abrirFoto(fotoAtual - 1); });
    lightbox.querySelector('[data-lightbox-proxima]').addEventListener('click', function () { abrirFoto(fotoAtual + 1); });
    lightbox.addEventListener('click', function (e) { if (e.target === lightbox) lightbox.close(); });
    lightbox.addEventListener('keydown', function (e) { if (e.key === 'ArrowLeft') abrirFoto(fotoAtual - 1); if (e.key === 'ArrowRight') abrirFoto(fotoAtual + 1); });
    var toqueX = null;
    lightbox.addEventListener('touchstart', function (e) { toqueX = e.touches[0].clientX; }, { passive: true });
    lightbox.addEventListener('touchend', function (e) {
      if (toqueX === null) return;
      var dx = e.changedTouches[0].clientX - toqueX; toqueX = null;
      if (Math.abs(dx) > 40) abrirFoto(fotoAtual + (dx < 0 ? 1 : -1));
    });
  }

  /* Gastronomia: fotos trocando sozinhas */
  var slides = document.querySelector('[data-slides]');
  if (slides) {
    var fotosSlides = slides.querySelectorAll('img'), pontos = document.querySelectorAll('.er-slides__ponto'), slideAtual = 0, timerSlides = null;
    function mostrarSlide(i) {
      slideAtual = (i + fotosSlides.length) % fotosSlides.length;
      fotosSlides.forEach(function (f, k) { f.classList.toggle('ativo', k === slideAtual); });
      pontos.forEach(function (p, k) { p.classList.toggle('ativo', k === slideAtual); });
      fotosSlides[(slideAtual + 1) % fotosSlides.length].loading = 'eager';
    }
    function iniciar() { if (!timerSlides && !reduzir) timerSlides = setInterval(function () { mostrarSlide(slideAtual + 1); }, 4000); }
    function parar() { clearInterval(timerSlides); timerSlides = null; }
    pontos.forEach(function (p, k) { p.addEventListener('click', function () { mostrarSlide(k); parar(); if (slides.dataset.naTela) iniciar(); }); });
    [['[data-slide-anterior]', -1], ['[data-slide-proxima]', 1]].forEach(function (b) {
      var bt = slides.querySelector(b[0]);
      if (bt) bt.addEventListener('click', function () { mostrarSlide(slideAtual + b[1]); parar(); if (slides.dataset.naTela) iniciar(); });
    });
    slides.addEventListener('mouseenter', parar);
    slides.addEventListener('mouseleave', function () { if (slides.dataset.naTela) iniciar(); });
    if (temIO) {
      new IntersectionObserver(function (es) {
        es.forEach(function (e) {
          if (e.isIntersecting) { slides.dataset.naTela = '1'; fotosSlides[1].loading = 'eager'; iniciar(); }
          else { delete slides.dataset.naTela; parar(); }
        });
      }, { threshold: 0.3 }).observe(slides);
    }
  }

  /* Carrosséis (depoimentos) */
  document.querySelectorAll('[data-carrossel]').forEach(function (trilho) {
    var nome = trilho.getAttribute('data-carrossel');
    var ant = document.querySelector('[data-anterior="' + nome + '"]');
    var prox = document.querySelector('[data-proximo="' + nome + '"]');
    var barra = document.querySelector('[data-progresso="' + nome + '"]');
    function passo() { var item = trilho.children[0]; return item ? item.getBoundingClientRect().width + 20 : trilho.clientWidth * 0.8; }
    function atualizar() {
      var max = trilho.scrollWidth - trilho.clientWidth, pos = trilho.scrollLeft;
      if (ant) ant.disabled = pos <= 4;
      if (prox) prox.disabled = pos >= max - 4;
      if (barra) {
        var visivel = trilho.clientWidth / trilho.scrollWidth;
        barra.style.width = (visivel * 100) + '%';
        barra.style.left = (max > 0 ? (pos / max) * (100 - visivel * 100) : 0) + '%';
      }
    }
    if (ant) ant.addEventListener('click', function () { trilho.scrollBy({ left: -passo(), behavior: reduzir ? 'auto' : 'smooth' }); });
    if (prox) prox.addEventListener('click', function () { trilho.scrollBy({ left: passo(), behavior: reduzir ? 'auto' : 'smooth' }); });
    trilho.addEventListener('scroll', atualizar, { passive: true });
    window.addEventListener('resize', atualizar);
    atualizar();
  });

  /* Ano no rodapé */
  var ano = document.querySelector('[data-ano]');
  if (ano) ano.textContent = String(new Date().getFullYear());
})();
</script>

<script>
/* Espaços no mobile: a legenda abaixo do carrossel mostra o ambiente que está no centro */
(function () {
  var lista = document.querySelector('.er-percurso__lista'), leg = document.querySelector('[data-percurso-legenda]');
  if (!lista || !leg) return;
  var cards = [].slice.call(lista.querySelectorAll('.er-ambiente'));
  var ant = document.querySelector('[data-percurso-anterior]'), prox = document.querySelector('[data-percurso-proxima]');
  var num = leg.querySelector('[data-leg-num]'), tit = leg.querySelector('[data-leg-tit]'), txt = leg.querySelector('[data-leg-txt]'), atual = 0;
  function mostrar(i) {
    if (i === atual) return;
    atual = i;
    leg.classList.add('troca');
    setTimeout(function () {
      var c = cards[i];
      num.textContent = c.querySelector('.er-ambiente__numero').textContent;
      tit.textContent = c.querySelector('h3').textContent;
      txt.textContent = c.querySelector('p').textContent;
      leg.classList.remove('troca');
    }, 200);
    if (ant) ant.disabled = i === 0;
    if (prox) prox.disabled = i === cards.length - 1;
  }
  function centro() {
    var meio = lista.getBoundingClientRect().left + lista.clientWidth / 2, melhor = 0, dist = Infinity;
    cards.forEach(function (c, k) { var r = c.getBoundingClientRect(), d = Math.abs(r.left + r.width / 2 - meio); if (d < dist) { dist = d; melhor = k; } });
    mostrar(melhor);
  }
  var agendado = false;
  lista.addEventListener('scroll', function () { if (!agendado) { agendado = true; requestAnimationFrame(function () { agendado = false; centro(); }); } }, { passive: true });
  function ir(k) { var c = cards[Math.max(0, Math.min(cards.length - 1, k))]; lista.scrollTo({ left: c.offsetLeft - (lista.clientWidth - c.offsetWidth) / 2, behavior: 'smooth' }); }
  if (ant) ant.addEventListener('click', function () { ir(atual - 1); });
  if (prox) prox.addEventListener('click', function () { ir(atual + 1); });
})();
</script>
