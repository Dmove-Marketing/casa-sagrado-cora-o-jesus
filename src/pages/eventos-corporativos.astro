      data-form-id="cscj-corporativos"
      data-submit-url={submitUrl}
      data-fonte="Landing page/eventos-corporativos"
      data-project={project}
      novalidate
    >
      <input type="text" name="website" style="display:none" aria-hidden="true" tabindex="-1" autocomplete="off" />
      <div class="er-campo er-campo--inteiro">
        <label for="c-nome">Nome</label>
        <input id="c-nome" name="nome" type="text" autocomplete="name" required />
      </div>
      <div class="er-campo">
        <label for="c-telefone">Telefone</label>
        <input id="c-telefone" name="telefone" type="tel" inputmode="tel" autocomplete="tel" required />
      </div>
      <div class="er-campo">
        <label for="c-email">E-mail</label>
        <input id="c-email" name="email" type="email" autocomplete="email" required />
      </div>
      <div class="er-campo">
        <label for="c-empresa">Empresa</label>
        <input id="c-empresa" name="empresa" type="text" autocomplete="organization" required />
      </div>
      <div class="er-campo">
        <label for="c-tipo">Tipo de evento</label>
        <select id="c-tipo" name="tipo_evento" required>
          <option value="" selected disabled>Selecione</option>
          {tipoEventoCorporativosOptions.map((o) => <option value={o.value}>{o.label}</option>)}
        </select>
      </div>
      <div class="er-campo">
        <label for="c-data">Data do evento</label>
        <input id="c-data" name="data_evento" type="text" inputmode="numeric" placeholder="dd/mm/aaaa" data-form-datepicker required />
      </div>
      <div class="er-campo">
        <label for="c-convidados"><span class="er-so-desktop">Número de convidados</span><span class="er-so-mobile">Nº de convidados</span></label>
        <input id="c-convidados" name="convidados" type="number" inputmode="numeric" min="1" required />
      </div>
      <div class="er-campo er-campo--inteiro">
        <label for="c-mensagem">Mensagem <span class="er-opcional">(opcional)</span></label>
        <textarea id="c-mensagem" name="detalhes_adicionais" rows="3" placeholder="Conte-nos um pouco sobre seu evento..."></textarea>
      </div>
      <button class="er-botao er-botao--escuro form-submit" type="button">
        <span class="btn-text">Solicitar orçamento</span>
        <span class="btn-loading" style="display:none">Enviando...</span>
      </button>
    </form>
  </div>
</section>

