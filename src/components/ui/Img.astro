---
import { Image } from 'astro:assets';

interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  /** true = eager + fetchpriority high (use na imagem LCP/hero) */
  priority?: boolean;
  /**
   * true = não baixa a imagem no carregamento da página: src/srcset saem como
   * data-src/data-srcset e o JS da página hidrata sob demanda (ex: slides
   * ocultos de carrossel sobreposto, onde o loading="lazy" dispara para todos).
   */
  defer?: boolean;
  quality?: number;
  class?: string;
  style?: string;
  /**
   * Atributo `sizes` do srcset responsivo (só se aplica a imagens do CDN media.dmove.com.br).
   * Padrão: "100vw" — ajuste para imagens que não ocupam a largura toda (ex: logos, thumbnails).
   */
  sizes?: string;
}

const {
  src,
  alt,
  width = 1200,
  height,
  priority = false,
  defer = false,
  quality = 80,
  class: className,
  style,
  sizes,
} = Astro.props;

// Se a URL for externa (CDN), renderiza <img> diretamente sem processamento local
const isExternal = src.startsWith('http://') || src.startsWith('https://');

// CDN próprio (media.dmove.com.br) suporta redimensionamento sob demanda via
// /api/public/resize/:width/clients/... — gera srcset responsivo real a partir dele.
const MEDIA_CDN_PREFIX = 'https://media.dmove.com.br/clients/';
const isMediaCdn = src.startsWith(MEDIA_CDN_PREFIX);
const RESIZE_WIDTHS = [400, 500, 600, 700, 800, 900, 1000, 1100, 1200, 1600, 2048];

function buildResizeUrl(url: string, w: number) {
  return url.replace('/clients/', `/api/public/resize/${w}/clients/`);
}

function buildSrcset(url: string, maxWidth: number) {
  const cap = Math.min(maxWidth * 2, 2048); // até 2x para telas retina
  const chosen = new Set(RESIZE_WIDTHS.filter((w) => w <= cap));
  chosen.add(Math.min(maxWidth, 2048));
  return [...chosen]
    .sort((a, b) => a - b)
    .map((w) => `${buildResizeUrl(url, w)} ${w}w`)
    .join(', ');
}

const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/**/*.{jpg,jpeg,png,webp,avif,gif}',
  { eager: true }
);

const key = `/src/assets/images/${src}`;
const mod = !isExternal ? images[key] : undefined;

if (!isExternal && !mod) {
  console.warn(`[Img] imagem não encontrada: ${key}`);
}
---

{isMediaCdn ? (
  <img
    src={defer ? undefined : src}
    srcset={defer ? undefined : buildSrcset(src, width)}
    data-src={defer ? src : undefined}
    data-srcset={defer ? buildSrcset(src, width) : undefined}
    sizes={sizes ?? '100vw'}
    alt={alt}
    width={width}
    height={height ?? undefined}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : undefined}
    class={className}
    style={style}
    decoding="async"
  />
) : isExternal ? (
  <img
    src={defer ? undefined : src}
    data-src={defer ? src : undefined}
    alt={alt}
    width={width}
    height={height ?? undefined}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : undefined}
    class={className}
    style={style}
    decoding="async"
  />
) : mod ? (
  <Image
    src={mod.default}
    alt={alt}
    width={width}
    height={height}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : undefined}
    quality={quality}
    class={className}
    style={style}
  />
) : (
  <img
    src=""
    alt={alt}
    width={width}
    height={height ?? undefined}
    class={className}
    style={style}
    data-placeholder={key}
    aria-hidden="true"
  />
)}
