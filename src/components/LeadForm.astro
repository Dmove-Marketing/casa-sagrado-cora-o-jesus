---
import config from '../../config.json';

interface Props {
  formId?: string;
  formName?: string;
  fonte?: string;
  compact?: boolean;
}

const {
  formId = 'cscj-home',
  formName = 'cscj-home',
  fonte = 'Site CSCJ — Home',
  compact = false,
} = Astro.props;

const submitUrl = config.forms['lead-form']?.webhooks[0] || '';
---

<form
  class="grid gap-4 md:grid-cols-2"
  data-form-id={formId}
  data-submit-url={submitUrl}
  data-fonte={fonte}
  data-project={config.project_slug}
  novalidate
>
  <!-- Honeypot anti-spam -->
  <input type="text" name="website" class="sr-only" aria-hidden="true" tabindex="-1" autocomplete="off" />

  <!-- Nome completo - full width -->
  <div class="md:col-span-2">
    <label class="block text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1.5" for={`nome-${formId}`}>Nome completo *</label>
    <input
      id={`nome-${formId}`}
      type="text"
      name="nome"
      required
      placeholder="Como podemos chamar você?"
      class="w-full rounded-md border border-input bg-background px-3.5 py-2.5 text-sm text-foreground placeholder:text-muted-foreground focus:border-accent focus:outline-none focus:ring-2 focus:ring-ring/30"
    />
  </div>

  <!-- E-mail -->
  <div>
    <label class="block text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1.5" for={`email-${formId}`}>E-mail *</label>
    <input
      id={`email-${formId}`}
      type="email"
      name="email"
      required
      placeholder="voce@email.com"
      class="w-full rounded-md border border-input bg-background px-3.5 py-2.5 text-sm text-foreground placeholder:text-muted-foreground focus:border-accent focus:outline-none focus:ring-2 focus:ring-ring/30"
    />
  </div>

  <!-- WhatsApp / Telefone -->
  <div>
    <label class="block text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1.5" for={`telefone-${formId}`}>WhatsApp / Telefone *</label>
    <input
      id={`telefone-${formId}`}
      type="tel"
      name="telefone"
      required
      placeholder="(11) 90000-0000"
      class="w-full rounded-md border border-input bg-background px-3.5 py-2.5 text-sm text-foreground placeholder:text-muted-foreground focus:border-accent focus:outline-none focus:ring-2 focus:ring-ring/30"
    />
  </div>

  <!-- Tipo de evento -->
  <div>
    <label class="block text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1.5" for={`tipo-${formId}`}>Tipo de evento</label>
    <select
      id={`tipo-${formId}`}
      name="tipo_evento"
      class="w-full rounded-md border border-input bg-background px-3.5 py-2.5 text-sm text-foreground focus:border-accent focus:outline-none focus:ring-2 focus:ring-ring/30"
    >
      <option value="">Selecione...</option>
      <option>Retiro espiritual</option>
      <option>Casamento intimista / Bodas</option>
      <option>Evento corporativo / Formação</option>
      <option>Imersão / Desenvolvimento humano</option>
      <option>Encontro educacional</option>
      <option>Outro</option>
    </select>
  </div>

  <!-- Data desejada -->
  <div>
    <label class="block text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1.5" for={`data-${formId}`}>Data desejada</label>
    <input
      id={`data-${formId}`}
      type="text"
      name="data_evento"
      placeholder="dd/mm/aaaa"
      data-form-datepicker="true"
      class="w-full rounded-md border border-input bg-background px-3.5 py-2.5 text-sm text-foreground placeholder:text-muted-foreground focus:border-accent focus:outline-none focus:ring-2 focus:ring-ring/30"
    />
  </div>

  <!-- Nº de participantes - full width -->
  <div class="md:col-span-2">
    <label class="block text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1.5" for={`convidados-${formId}`}>Nº de participantes</label>
    <input
      id={`convidados-${formId}`}
      type="number"
      name="convidados"
      min="1"
      placeholder="Ex.: 30"
      class="w-full rounded-md border border-input bg-background px-3.5 py-2.5 text-sm text-foreground placeholder:text-muted-foreground focus:border-accent focus:outline-none focus:ring-2 focus:ring-ring/30"
    />
  </div>

  <!-- Mensagem - full width -->
  <div class="md:col-span-2">
    <label class="block text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1.5" for={`msg-${formId}`}>Mensagem</label>
    <textarea
      id={`msg-${formId}`}
      name="detalhes_adicionais"
      rows="4"
      placeholder="Conte-nos um pouco sobre seu evento ou retiro..."
      class="w-full rounded-md border border-input bg-background px-3.5 py-2.5 text-sm text-foreground placeholder:text-muted-foreground focus:border-accent focus:outline-none focus:ring-2 focus:ring-ring/30"
    ></textarea>
  </div>

  <!-- Submit - full width -->
  <div class="md:col-span-2">
    <button
      type="button"
      class="form-submit w-full rounded-full bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground transition hover:bg-secondary disabled:opacity-60"
    >
      <span class="btn-text">Solicitar orçamento</span>
      <span class="btn-loading hidden">Enviando...</span>
    </button>
    <p class="mt-3 text-center text-xs text-muted-foreground">Suas informações são tratadas com cuidado e usadas apenas para responder ao seu contato.</p>
  </div>
</form>

<script>
  import { initForms } from '../scripts/forms';
  document.addEventListener('DOMContentLoaded', initForms);
  if (document.readyState !== 'loading') initForms();
</script>

<script>
  import flatpickr from 'flatpickr';
  import { Portuguese } from 'flatpickr/dist/l10n/pt.js';
  import 'flatpickr/dist/flatpickr.min.css';

  function initDatepickers() {
    document.querySelectorAll<HTMLInputElement>('[data-form-datepicker]').forEach(el => {
      if (el.dataset.flatpickrReady) return;
      el.dataset.flatpickrReady = 'true';
      flatpickr(el, { locale: Portuguese, dateFormat: 'd/m/Y', minDate: 'today', allowInput: true });
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDatepickers);
  } else {
    initDatepickers();
  }
</script>
